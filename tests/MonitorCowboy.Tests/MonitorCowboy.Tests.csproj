<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      Plain net9.0 on purpose: the suite covers only the OS-agnostic layer
      (parser, router, models, settings, diagnostics), compiled in by source so
      it runs anywhere. Windows-only behavior is exercised on real hardware.
    -->
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <RootNamespace>MonitorCowboy.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../src/Core/**/*.cs" LinkBase="Core" />
    <Compile Include="../../src/Diagnostics/**/*.cs" LinkBase="Diagnostics" />
    <Compile Include="../../src/Interop/INativeMonitorApi.cs" Link="Interop/INativeMonitorApi.cs" />
    <Compile Include="../../src/PluginSettings.cs" Link="PluginSettings.cs" />
    <Compile Include="../../src/FlowSettingsStore.cs" Link="FlowSettingsStore.cs" />
    <Compile Include="../../src/Ui/QueryIntents.cs" Link="Ui/QueryIntents.cs" />
    <Compile Include="../../src/Ui/QueryRouter.cs" Link="Ui/QueryRouter.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

</Project>
